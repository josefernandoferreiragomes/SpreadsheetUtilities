@page "/etl-assistant"
@using SpreadsheetUtility.Application.Ports
@inject ILlmTransformerService LlmTransformer
@inject EtlAssistantViewModel ViewModel
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>ETL Assistant</PageTitle>

<h3>&#x1FA9E; ETL Assistant</h3>
<p class="text-muted">Paste data in any format &mdash; the AI transforms it to our project formats, or explains why it cannot.</p>

<hr />

@* Projects Card *@
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Projects</h5>
    </div>
    <div class="card-body">
        <div class="etl-grid">
            <div class="etl-input">
                <label class="form-label">Input (any table format)</label>
                <textarea class="form-control etl-textarea" @bind="ViewModel.ProjectsInput" placeholder="Paste project data here (CSV, TSV, markdown table, etc.)"></textarea>
            </div>
            <div class="etl-output">
                <label class="form-label">Output (projects.txt format)</label>
                <textarea class="form-control etl-textarea" readonly value="@ViewModel.ProjectsOutput"></textarea>
                @if (ViewModel.ProjectsIsSuccess)
                {
                    <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => DownloadProjects()">&#x1F4E5; Download projects.txt</button>
                }
            </div>
        </div>
        <div class="mt-2">
            <button class="btn btn-primary" @onclick="TransformProjects" disabled="@ViewModel.ProjectsIsLoading">
                @if (ViewModel.ProjectsIsLoading)
                {
                    <span>&#x23F3; Transforming...</span>
                }
                else
                {
                    <span>&#x1F504; Transform to Projects</span>
                }
            </button>
            @if (ViewModel.ProjectsError is not null)
            {
                <div class="alert alert-warning mt-2 mb-0">&#x26A0;&#xFE0F; @ViewModel.ProjectsError</div>
            }
        </div>
    </div>
</div>

@* Tasks Card *@
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Tasks</h5>
    </div>
    <div class="card-body">
        <div class="etl-grid">
            <div class="etl-input">
                <label class="form-label">Input (any table format)</label>
                <textarea class="form-control etl-textarea" @bind="ViewModel.TasksInput" placeholder="Paste task data here (CSV, TSV, markdown table, etc.)"></textarea>
            </div>
            <div class="etl-output">
                <label class="form-label">Output (tasks.txt format)</label>
                <textarea class="form-control etl-textarea" readonly value="@ViewModel.TasksOutput"></textarea>
                @if (ViewModel.TasksIsSuccess)
                {
                    <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => DownloadTasks()">&#x1F4E5; Download tasks.txt</button>
                }
            </div>
        </div>
        <div class="mt-2">
            <button class="btn btn-primary" @onclick="TransformTasks" disabled="@ViewModel.TasksIsLoading">
                @if (ViewModel.TasksIsLoading)
                {
                    <span>&#x23F3; Transforming...</span>
                }
                else
                {
                    <span>&#x1F504; Transform to Tasks</span>
                }
            </button>
            @if (ViewModel.TasksError is not null)
            {
                <div class="alert alert-warning mt-2 mb-0">&#x26A0;&#xFE0F; @ViewModel.TasksError</div>
            }
        </div>
    </div>
</div>

@* Team Card *@
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Team</h5>
    </div>
    <div class="card-body">
        <div class="etl-grid">
            <div class="etl-input">
                <label class="form-label">Input (any table format)</label>
                <textarea class="form-control etl-textarea" @bind="ViewModel.TeamInput" placeholder="Paste team/developer data here (CSV, TSV, markdown table, etc.)"></textarea>
            </div>
            <div class="etl-output">
                <label class="form-label">Output (team.txt format)</label>
                <textarea class="form-control etl-textarea" readonly value="@ViewModel.TeamOutput"></textarea>
                @if (ViewModel.TeamIsSuccess)
                {
                    <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => DownloadTeam()">&#x1F4E5; Download team.txt</button>
                }
            </div>
        </div>
        <div class="mt-2">
            <button class="btn btn-primary" @onclick="TransformTeam" disabled="@ViewModel.TeamIsLoading">
                @if (ViewModel.TeamIsLoading)
                {
                    <span>&#x23F3; Transforming...</span>
                }
                else
                {
                    <span>&#x1F504; Transform to Team</span>
                }
            </button>
            @if (ViewModel.TeamError is not null)
            {
                <div class="alert alert-warning mt-2 mb-0">&#x26A0;&#xFE0F; @ViewModel.TeamError</div>
            }
        </div>
    </div>
</div>

<style>
    .etl-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
    .etl-textarea {
        min-height: 200px;
        font-family: 'Courier New', monospace;
        font-size: 0.875rem;
        resize: vertical;
    }
    .etl-input .etl-textarea,
    .etl-output .etl-textarea {
        width: 100%;
    }
    @@media (max-width: 768px) {
        .etl-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    protected override void OnInitialized()
    {
        ViewModel.Reset();
    }

    private async Task TransformProjects()
    {
        await ViewModel.TransformProjectsAsync(LlmTransformer);
    }

    private async Task TransformTasks()
    {
        await ViewModel.TransformTasksAsync(LlmTransformer);
    }

    private async Task TransformTeam()
    {
        await ViewModel.TransformTeamAsync(LlmTransformer);
    }

    private async Task DownloadProjects()
    {
        await JS.InvokeVoidAsync("downloadTextFile", ViewModel.ProjectsOutput, "projects.txt");
    }

    private async Task DownloadTasks()
    {
        await JS.InvokeVoidAsync("downloadTextFile", ViewModel.TasksOutput, "tasks.txt");
    }

    private async Task DownloadTeam()
    {
        await JS.InvokeVoidAsync("downloadTextFile", ViewModel.TeamOutput, "team.txt");
    }
}
